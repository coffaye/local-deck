<Window x:Class="LocalDeck.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:LocalDeck.Controls"
        Title="桌仪" Icon="/assets/LocalDeck.ico"
        Width="360" Height="360" MinWidth="360" MinHeight="330"
        MaxWidth="360" MaxHeight="360"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent"
        Foreground="{StaticResource ScreenTextBrush}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        SourceInitialized="Window_SourceInitialized">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="CompactHeroStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="40" />
            <Setter Property="Foreground" Value="{StaticResource AccentCyanBrush}" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale" />
        </Style>

        <Style x:Key="CompactLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="7.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource ScreenMutedBrush}" />
        </Style>

        <Style x:Key="CompactCaptionStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="6.5" />
            <Setter Property="Foreground" Value="{StaticResource ScreenMutedBrush}" />
        </Style>

        <!-- Top tabs: text only, no surrounding frame. -->
        <Style x:Key="NavTabStyle" TargetType="Button">
            <Setter Property="Height" Value="22" />
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Margin" Value="0,0,3,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource ScreenMutedBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="8.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AccentCyanBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AccentYellowBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavTabActiveStyle" TargetType="Button" BasedOn="{StaticResource NavTabStyle}">
            <Setter Property="Foreground" Value="{StaticResource AccentPinkBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <!-- Window controls: icon-only, no frame. -->
        <Style x:Key="MiniIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource ScreenMutedBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="3" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A0745" />
                                <Setter Property="Foreground" Value="{StaticResource AccentCyanBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AccentYellowBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MiniIconToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource ScreenMutedBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" CornerRadius="3" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A0745" />
                                <Setter Property="Foreground" Value="{StaticResource AccentCyanBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AccentYellowBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact form primitives. -->
        <Style x:Key="MiniFieldLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource FieldLabelStyle}">
            <Setter Property="FontSize" Value="8" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>

        <Style x:Key="SettingsSectionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource ScreenTextBrush}" />
        </Style>

        <Style x:Key="MiniTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource DarkTextBoxStyle}">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="FontSize" Value="8" />
        </Style>

        <Style x:Key="MiniPasswordBoxStyle" TargetType="PasswordBox" BasedOn="{StaticResource DarkPasswordBoxStyle}">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="FontSize" Value="8.5" />
        </Style>

        <Style x:Key="MiniButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="FontSize" Value="8" />
        </Style>

        <Style x:Key="MiniPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryActionButtonStyle}">
            <Setter Property="Height" Value="26" />
            <Setter Property="MinWidth" Value="68" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="8.5" />
        </Style>

        <Style x:Key="MiniComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource DarkComboBoxStyle}">
            <Setter Property="Height" Value="26" />
            <Setter Property="MinWidth" Value="58" />
            <Setter Property="FontSize" Value="8" />
        </Style>

        <Style x:Key="MiniToggleStyle" TargetType="CheckBox">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Border x:Name="Track" Width="26" Height="14" CornerRadius="7"
                                    Background="{StaticResource ScreenTrackBrush}" BorderBrush="{StaticResource FrameLineBrush}" BorderThickness="1" />
                            <Ellipse x:Name="Thumb" Width="8" Height="8" Fill="{StaticResource ScreenMutedBrush}"
                                     HorizontalAlignment="Left" Margin="3,0,0,0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentCyanBrush}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource AccentCyanBrush}" />
                                <Setter TargetName="Thumb" Property="Fill" Value="{StaticResource DeepBlackBrush}" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource AccentPinkBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OpacitySliderStyle" TargetType="Slider">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Minimum" Value="0.35" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="12" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent" Margin="0,2">
                            <Border Height="3" VerticalAlignment="Center" Margin="2,0"
                                    CornerRadius="1.5">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00F0FF" Offset="0" />
                                        <GradientStop Color="#FF007F" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Track x:Name="PART_Track" Orientation="Horizontal" Margin="2,0">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="5" Height="10">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{StaticResource AccentCyanBrush}" CornerRadius="0.5" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TrayMenuItemStyle" TargetType="MenuItem">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Foreground" Value="#F7F4FF" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="False" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF007F" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Frame" CornerRadius="8" BorderBrush="{StaticResource FrameLineBrush}" BorderThickness="1"
            Background="Transparent">
        <Grid>
            <Border x:Name="Backdrop" CornerRadius="7">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#12003B" Offset="0" />
                        <GradientStop Color="#0A0A0F" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border x:Name="TopBarHost" Grid.Row="0" Height="30" Background="Transparent" CornerRadius="7,7,0,0">
                <Grid x:Name="TopBar" Background="Transparent" MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                        <Image Source="/assets/LocalDeck-logo.png" Width="20" Height="20"
                               Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="桌仪" FontSize="8.5" FontWeight="Bold"
                                   Foreground="{StaticResource ScreenTextBrush}"
                                   VerticalAlignment="Center" Margin="4,0,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Button x:Name="TabMonitorButton" Content="检测台" Style="{StaticResource NavTabActiveStyle}"
                                Click="ShowMonitor_Click" />
                        <Button x:Name="TabSettingsButton" Content="设置" Style="{StaticResource NavTabStyle}"
                                Click="ShowSettings_Click" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                        <Slider x:Name="OpacitySlider" Style="{StaticResource OpacitySliderStyle}"
                                Margin="0,0,6,0" VerticalAlignment="Center" ToolTip="背景透明度"
                                ValueChanged="OpacitySlider_ValueChanged" />
                        <ToggleButton x:Name="PinToggle" Style="{StaticResource MiniIconToggleStyle}"
                                      Click="PinToggle_Click" ToolTip="置顶">
                            <Viewbox Width="12" Height="12">
                                <Path Data="M8 3h8v2l-2 2v4l3 3v2H7v-2l3-3V7L8 5V3z M12 15v7"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                      StrokeThickness="1.7" Fill="Transparent"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Viewbox>
                        </ToggleButton>
                        <Button Style="{StaticResource MiniIconButtonStyle}" Margin="1,0,0,0"
                                Click="Minimize_Click" ToolTip="最小化">
                            <Viewbox Width="12" Height="12">
                                <Path Data="M4 12h16"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Viewbox>
                        </Button>
                        <Button Style="{StaticResource MiniIconButtonStyle}" Margin="1,0,0,0"
                                Click="Close_Click" ToolTip="隐藏到托盘">
                            <Viewbox Width="12" Height="12">
                                <Path Data="M5 5l14 14 M19 5L5 19"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Viewbox>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- The LCD. No page title above the content. -->
            <Border x:Name="ScreenSurface" Grid.Row="1" Background="Transparent" CornerRadius="0,0,7,7" />

            <Grid Grid.Row="1" Margin="6,4,6,8">
                <!-- ░░ MONITOR -->
                <Grid x:Name="MonitorPage" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="84" />
                        <RowDefinition Height="86" />
                        <RowDefinition Height="44" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- CPU / memory; the two segmented bars share one row. -->
                    <Grid x:Name="HeroRow" Margin="2,0,2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="11" />
                            <RowDefinition Height="50" />
                            <RowDefinition Height="7" />
                            <RowDefinition Height="16" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="CPU 占用" Style="{StaticResource CompactLabelStyle}" FontSize="8.5" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="内存占用" Style="{StaticResource CompactLabelStyle}" FontSize="8.5" />

                        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="CpuValueText" Text="{Binding CpuValue}" Style="{StaticResource CompactHeroStyle}" />
                            <TextBlock x:Name="CpuPercentUnit" Text="%" FontFamily="{StaticResource NarrowFont}" FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource AccentYellowBrush}" Margin="4,0,0,5" VerticalAlignment="Bottom" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="MemoryValueText" Text="{Binding MemoryValue}" Style="{StaticResource CompactHeroStyle}" />
                            <TextBlock x:Name="MemoryPercentUnit" Text="%" FontFamily="{StaticResource NarrowFont}" FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource AccentYellowBrush}" Margin="4,0,0,5" VerticalAlignment="Bottom" />
                        </StackPanel>

                        <controls:SegmentedBar x:Name="CpuBar" Grid.Row="2" Grid.Column="0" Height="6" Margin="0,1,0,0"
                                               Value="{Binding CpuPercent}" Fill="{StaticResource AccentCyanBrush}"
                                               Track="{StaticResource ScreenTrackBrush}" SegmentCount="28" />
                        <controls:SegmentedBar x:Name="MemoryBar" Grid.Row="2" Grid.Column="2" Height="6" Margin="0,1,0,0"
                                               Value="{Binding MemoryPercent}" Fill="{StaticResource AccentPinkBrush}"
                                               Track="{StaticResource ScreenTrackBrush}" SegmentCount="28" />

                        <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding MemoryDetail}"
                                   Style="{StaticResource CompactCaptionStyle}" FontSize="8"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Bottom" />
                    </Grid>

                    <!-- Quiet two-trace history strip. -->
                    <Border x:Name="ChartPanel" Grid.Row="1" Margin="2,4,2,0" Background="#33000000" CornerRadius="4" Padding="7,5">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <TextBlock Text="使用率历史" FontSize="7.5" Foreground="{StaticResource ScreenMutedBrush}" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Ellipse Width="4" Height="4" Fill="{StaticResource AccentCyanBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBlock Text="CPU" FontSize="6" Foreground="{StaticResource ScreenMutedBrush}" />
                                    <Ellipse Width="4" Height="4" Fill="{StaticResource AccentYellowBrush}" VerticalAlignment="Center" Margin="9,0,4,0" />
                                    <TextBlock Text="内存" FontSize="6" Foreground="{StaticResource ScreenMutedBrush}" />
                                </StackPanel>
                            </Grid>
                            <Grid Grid.Row="1" Margin="0,3,0,0" ClipToBounds="True">
                                <controls:Sparkline Values="{Binding MemorySpark}" Stroke="{StaticResource AccentYellowBrush}"
                                                    Opacity="0.82" IsHitTestVisible="False" />
                                <controls:Sparkline Values="{Binding CpuSpark}" Stroke="{StaticResource AccentCyanBrush}"
                                                    IsHitTestVisible="False" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Thermal, integrated GPU, discrete GPU, network. -->
                    <Grid x:Name="SpecsRow" Grid.Row="2" Margin="2,4,2,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.92*" />
                            <ColumnDefinition Width="1.08*" />
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="1.22*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Margin="0,0,4,0">
                            <TextBlock Text="温度" Style="{StaticResource CompactCaptionStyle}" FontSize="7" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding CpuTemp}" FontFamily="{StaticResource DisplayFont}" FontSize="12"
                                           Foreground="{Binding TempBrush}" VerticalAlignment="Bottom" />
                                <TextBlock Text="°C" FontFamily="{StaticResource NarrowFont}" FontSize="7"
                                           Foreground="{StaticResource ScreenMutedBrush}" VerticalAlignment="Bottom" Margin="2,0,0,2" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,4,0">
                            <TextBlock Text="核显" Style="{StaticResource CompactCaptionStyle}" FontSize="7"
                                       ToolTip="{Binding IntegratedGpuName, StringFormat={}{0} · 温度不可用}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding IntegratedGpuUsage}" FontFamily="{StaticResource DisplayFont}"
                                           FontSize="11" Foreground="{StaticResource AccentCyanBrush}" VerticalAlignment="Bottom" />
                                <TextBlock Text="%" FontFamily="{StaticResource NarrowFont}" FontSize="7"
                                           Foreground="{StaticResource AccentYellowBrush}" VerticalAlignment="Bottom" Margin="1,0,2,2" />
                                <TextBlock Text="/" FontSize="7" Foreground="{StaticResource ScreenDimBrush}"
                                           VerticalAlignment="Bottom" Margin="0,0,2,2" />
                                <TextBlock Text="—" FontFamily="{StaticResource UiFont}" FontSize="8"
                                           Foreground="{StaticResource ScreenDimBrush}" VerticalAlignment="Bottom" Margin="0,0,0,2" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="0,0,4,0">
                            <TextBlock Text="独显" Style="{StaticResource CompactCaptionStyle}" FontSize="7"
                                       ToolTip="{Binding DiscreteGpuName}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding DiscreteGpuUsage}" FontFamily="{StaticResource DisplayFont}"
                                           FontSize="11" Foreground="{StaticResource AccentCyanBrush}" VerticalAlignment="Bottom" />
                                <TextBlock Text="%" FontFamily="{StaticResource NarrowFont}" FontSize="7"
                                           Foreground="{StaticResource AccentYellowBrush}" VerticalAlignment="Bottom" Margin="1,0,2,2" />
                                <TextBlock Text="/" FontSize="7" Foreground="{StaticResource ScreenDimBrush}"
                                           VerticalAlignment="Bottom" Margin="0,0,2,2" />
                                <TextBlock Text="{Binding DiscreteGpuTemp}" FontFamily="{StaticResource DisplayFont}"
                                           FontSize="11" Foreground="{StaticResource AccentCyanBrush}" VerticalAlignment="Bottom" />
                                <TextBlock Text="℃" FontFamily="{StaticResource NarrowFont}" FontSize="8"
                                           Foreground="{StaticResource ScreenMutedBrush}" VerticalAlignment="Bottom" Margin="1,0,0,2" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="3" HorizontalAlignment="Right">
                            <TextBlock Text="网络" Style="{StaticResource CompactCaptionStyle}" FontSize="7" HorizontalAlignment="Right" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="↑" FontSize="7" Foreground="{StaticResource AccentCyanBrush}"
                                           VerticalAlignment="Center" Margin="0,0,2,0" />
                                <TextBlock Text="{Binding NetUp}" FontFamily="{StaticResource MonoFont}" FontSize="7"
                                           Foreground="{StaticResource ScreenMutedBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,1,0,0">
                                <TextBlock Text="↓" FontSize="7" Foreground="{StaticResource AccentPinkBrush}"
                                           VerticalAlignment="Center" Margin="0,0,2,0" />
                                <TextBlock Text="{Binding NetDown}" FontFamily="{StaticResource MonoFont}" FontSize="7"
                                           Foreground="{StaticResource ScreenMutedBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Codex + Claude + DeepSeek summary. -->
                    <Border x:Name="QuotaPanel" Grid.Row="3" Margin="2,4,2,0" Background="#33000000"
                            BorderBrush="{StaticResource ScreenLineBrush}" BorderThickness="1" CornerRadius="5"
                            Padding="8,7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.35*" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Codex is narrower now: each window keeps its own reset line. -->
                            <Grid Grid.Column="0" Margin="0,0,4,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="CODEX" FontFamily="{StaticResource MonoFont}" FontSize="7"
                                                   FontWeight="Bold" Foreground="{StaticResource ScreenTextBrush}" />
                                        <TextBlock Text="{Binding Codex.PlanText}" FontFamily="{StaticResource MonoFont}"
                                                   FontSize="5.5" Foreground="{StaticResource AccentYellowBrush}" Margin="3,1,0,0" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Ellipse Width="4" Height="4" Fill="{Binding Codex.StatusBrush}"
                                                 VerticalAlignment="Center" Margin="0,0,3,0" />
                                        <TextBlock Text="{Binding Codex.StatusText}" FontSize="5.5"
                                                   Foreground="{Binding Codex.StatusBrush}" />
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="1" Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel x:Name="CodexPrimaryStack">
                                        <TextBlock x:Name="CodexPrimaryLabelText" Text="{Binding Codex.PrimaryLabel}" Style="{StaticResource CompactCaptionStyle}"
                                                   FontSize="6" />
                                        <TextBlock x:Name="CodexPrimaryValueText" Text="{Binding Codex.PrimaryRemainingText}" FontFamily="{StaticResource DisplayFont}"
                                                   FontSize="18" Foreground="{Binding Codex.PrimaryBrush}" />
                                        <controls:SegmentedBar Height="3" Margin="0,1,0,0"
                                                               Value="{Binding Codex.PrimaryRemaining}"
                                                               Fill="{Binding Codex.PrimaryBrush}"
                                                               Track="{StaticResource ScreenTrackBrush}" SegmentCount="18" />
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0"
                                                    ToolTip="{Binding Codex.ResetCreditsText}">
                                            <TextBlock Text="↻ " FontSize="5.2" Foreground="{StaticResource ScreenDimBrush}" />
                                            <TextBlock Text="{Binding Codex.PrimaryResetText}" FontSize="5.2"
                                                       Foreground="{StaticResource ScreenDimBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel x:Name="CodexSecondaryStack" Grid.Column="2">
                                        <TextBlock x:Name="CodexSecondaryLabelText" Text="{Binding Codex.SecondaryLabel}" Style="{StaticResource CompactCaptionStyle}"
                                                   FontSize="6" />
                                        <TextBlock x:Name="CodexSecondaryValueText" Text="{Binding Codex.SecondaryRemainingText}" FontFamily="{StaticResource DisplayFont}"
                                                   FontSize="18" Foreground="{Binding Codex.SecondaryBrush}" />
                                        <controls:SegmentedBar Height="3" Margin="0,1,0,0"
                                                               Value="{Binding Codex.SecondaryRemaining}"
                                                               Fill="{Binding Codex.SecondaryBrush}"
                                                               Track="{StaticResource ScreenTrackBrush}" SegmentCount="18" />
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0"
                                                    ToolTip="{Binding Codex.ResetCreditsText}">
                                            <TextBlock Text="↻ " FontSize="5.2" Foreground="{StaticResource ScreenDimBrush}" />
                                            <TextBlock Text="{Binding Codex.SecondaryResetText}" FontSize="5.2"
                                                       Foreground="{StaticResource ScreenDimBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Grid>

                            <Border Grid.Column="1" Background="{StaticResource ScreenLineBrush}" Margin="0,1,0,1" />

                            <!-- Claude prepaid supplier balance. Token and endpoint are read from Claude CLI config. -->
                            <Grid Grid.Column="2" Margin="7,0,6,0"
                                  ToolTip="{Binding Claude.HintText}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <TextBlock Text="CLAUDE" FontFamily="{StaticResource MonoFont}" FontSize="7"
                                               FontWeight="Bold" Foreground="{StaticResource ScreenTextBrush}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Ellipse Width="4" Height="4" Fill="{Binding Claude.StatusBrush}"
                                                 VerticalAlignment="Center" Margin="0,0,3,0" />
                                        <TextBlock Text="{Binding Claude.StatusText}" FontSize="5.5"
                                                   Foreground="{Binding Claude.StatusBrush}" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Claude.CurrencySymbol}" FontFamily="{StaticResource NarrowFont}"
                                                   FontSize="8" FontWeight="Bold" Foreground="{StaticResource ScreenMutedBrush}"
                                                   VerticalAlignment="Bottom" Margin="0,0,2,3" />
                                        <TextBlock x:Name="ClaudeBalanceValueText" Text="{Binding Claude.BalanceText}"
                                                   FontFamily="{StaticResource DisplayFont}" FontSize="22"
                                                   Foreground="{StaticResource AccentYellowBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Claude.TodayText}" FontSize="6.2"
                                               Foreground="{StaticResource ScreenMutedBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>

                            <Border Grid.Column="3" Background="{StaticResource ScreenLineBrush}" Margin="0,1,0,1" />

                            <Grid Grid.Column="4" Margin="7,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <TextBlock Text="DEEPSEEK" FontFamily="{StaticResource MonoFont}" FontSize="7"
                                               FontWeight="Bold" Foreground="{StaticResource ScreenTextBrush}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Ellipse Width="4" Height="4" Fill="{Binding DeepSeek.StatusBrush}"
                                                 VerticalAlignment="Center" Margin="0,0,3,0" />
                                        <TextBlock Text="{Binding DeepSeek.StatusText}" FontSize="5.5"
                                                   Foreground="{Binding DeepSeek.StatusBrush}" />
                                    </StackPanel>
                                </Grid>
                                <Grid Grid.Row="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DeepSeek.HasData}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="{Binding DeepSeek.CurrencySymbol}" FontFamily="{StaticResource NarrowFont}"
                                                   FontSize="8" FontWeight="Bold" Foreground="{StaticResource ScreenMutedBrush}"
                                                   VerticalAlignment="Bottom" Margin="0,0,2,3" />
                                        <TextBlock x:Name="DeepSeekBalanceValueText" Text="{Binding DeepSeek.BalanceText}" FontFamily="{StaticResource DisplayFont}"
                                                   FontSize="22" Foreground="{StaticResource AccentYellowBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="—" FontFamily="{StaticResource MonoFont}" FontSize="15"
                                               Foreground="{StaticResource ScreenDimBrush}" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DeepSeek.HasData}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ░░ SETTINGS -->
                <Grid x:Name="SettingsPage" Visibility="Collapsed" Margin="2,2,2,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="34" />
                    </Grid.RowDefinitions>
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                        <StackPanel>
                    <Border Background="#30000000" BorderBrush="{StaticResource ScreenLineBrush}"
                            BorderThickness="1" CornerRadius="5" Padding="8,5">
                        <StackPanel>
                            <TextBlock Text="数据源" Style="{StaticResource SettingsSectionStyle}" />
                            <TextBlock Text="Codex 路径" Style="{StaticResource MiniFieldLabelStyle}" Margin="0,5,0,2" />
                            <Grid Height="26">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="CodexPathBox" Style="{StaticResource MiniTextBoxStyle}" IsReadOnly="True" />
                                <Button Grid.Column="2" Content="自动" Style="{StaticResource MiniButtonStyle}"
                                        Width="42" Click="AutoDetectCodex_Click" />
                                <Button Grid.Column="4" Content="浏览" Style="{StaticResource MiniButtonStyle}"
                                        Width="36" Click="BrowseCodex_Click" />
                            </Grid>
                            <TextBlock x:Name="CodexDetectText" Visibility="Collapsed" />

                            <TextBlock Text="DeepSeek 密钥" Style="{StaticResource MiniFieldLabelStyle}" Margin="0,6,0,2" />
                            <Grid Height="26">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <PasswordBox x:Name="ApiKeyBox" Style="{StaticResource MiniPasswordBoxStyle}"
                                             ToolTip="已保存的密钥不会显示；留空保存不会清除已保存的密钥。" />
                                <Button Grid.Column="2" Content="测试" Style="{StaticResource MiniButtonStyle}"
                                        Width="36" Click="TestDeepSeek_Click" />
                                <Button Grid.Column="4" Content="清除" Style="{StaticResource MiniButtonStyle}"
                                        Width="36" Click="ClearApiKey_Click" />
                            </Grid>
                            <TextBlock x:Name="ApiKeyStatusText" Text="尚未配置" Style="{StaticResource CompactCaptionStyle}"
                                       FontSize="7" Foreground="{StaticResource ScreenMutedBrush}" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Background="#30000000" BorderBrush="{StaticResource ScreenLineBrush}"
                            BorderThickness="1" CornerRadius="5" Padding="8,5" Margin="0,4,0,0">
                        <StackPanel>
                            <TextBlock Text="刷新" Style="{StaticResource SettingsSectionStyle}" />
                            <Grid Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="5" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="5" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="统计网卡" Style="{StaticResource MiniFieldLabelStyle}" />
                                    <ComboBox x:Name="NetworkCombo" Style="{StaticResource MiniComboBoxStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="额度刷新" Style="{StaticResource MiniFieldLabelStyle}" />
                                    <ComboBox x:Name="QuotaRefreshCombo" Style="{StaticResource MiniComboBoxStyle}">
                                        <ComboBoxItem Content="1 分钟" Tag="1" />
                                        <ComboBoxItem Content="5 分钟" Tag="5" />
                                        <ComboBoxItem Content="15 分钟" Tag="15" />
                                        <ComboBoxItem Content="30 分钟" Tag="30" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="硬件刷新" Style="{StaticResource MiniFieldLabelStyle}" />
                                    <ComboBox x:Name="HardwareIntervalCombo" Style="{StaticResource MiniComboBoxStyle}">
                                        <ComboBoxItem Content="1 秒" Tag="1" />
                                        <ComboBoxItem Content="2 秒" Tag="2" />
                                        <ComboBoxItem Content="5 秒" Tag="5" />
                                        <ComboBoxItem Content="10 秒" Tag="10" />
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Background="#30000000" BorderBrush="{StaticResource ScreenLineBrush}"
                            BorderThickness="1" CornerRadius="5" Padding="8,5" Margin="0,4,0,0">
                        <StackPanel>
                            <TextBlock Text="Claude" Style="{StaticResource SettingsSectionStyle}" />
                            <TextBlock Text="自动读取 Claude CLI 的 Key 和 Base URL；留空使用 CLI 配置"
                                       FontSize="6.3" Foreground="{StaticResource ScreenMutedBrush}" Margin="0,2,0,0" />
                            <TextBlock Text="查询地址" Style="{StaticResource MiniFieldLabelStyle}" Margin="0,4,0,2" />
                            <Grid Height="26">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ClaudeQueryUrlBox" Style="{StaticResource MiniTextBoxStyle}"
                                         ToolTip="留空或点「自动」使用 Claude CLI 配置推导出的 /v1/usage 地址" />
                                <Button Grid.Column="2" Content="自动" Style="{StaticResource MiniButtonStyle}"
                                        Width="42" Click="AutoDetectClaude_Click" />
                            </Grid>
                            <TextBlock Text="Claude Key（留空用 CLI 配置）" Style="{StaticResource MiniFieldLabelStyle}"
                                       Margin="0,4,0,2" />
                            <Grid Height="26">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <PasswordBox x:Name="ClaudeApiKeyBox" Style="{StaticResource MiniPasswordBoxStyle}"
                                             ToolTip="仅在本机 DPAPI 加密保存；留空时读取 Claude CLI 配置" />
                                <Button Grid.Column="2" Content="测试" Style="{StaticResource MiniButtonStyle}"
                                        Width="36" Click="TestClaude_Click" />
                                <Button Grid.Column="4" Content="清除" Style="{StaticResource MiniButtonStyle}"
                                        Width="36" Click="ClearClaudeKey_Click" />
                            </Grid>
                            <TextBlock x:Name="ClaudeStatusText" Text="自动读取 Claude CLI 配置" Style="{StaticResource CompactCaptionStyle}"
                                       FontSize="6.5" Foreground="{StaticResource ScreenMutedBrush}" Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>

                    <Border Background="#30000000" BorderBrush="{StaticResource ScreenLineBrush}"
                            BorderThickness="1" CornerRadius="5" Padding="8,5" Margin="0,4,0,0">
                        <StackPanel>
                            <Grid Height="20">
                                <TextBlock Text="窗口" Style="{StaticResource SettingsSectionStyle}" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="主题" FontSize="7.5" Foreground="{StaticResource ScreenMutedBrush}"
                                               VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <ComboBox x:Name="ThemeCombo" Width="88" Height="20" FontSize="7.5"
                                              Style="{StaticResource MiniComboBoxStyle}">
                                        <ComboBoxItem Content="性能优先" Tag="0" />
                                        <ComboBoxItem Content="额度优先" Tag="1" />
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                            <Grid Height="26" Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="窗口置顶" FontSize="8" Foreground="{StaticResource ScreenTextBrush}"
                                               VerticalAlignment="Center" />
                                    <CheckBox x:Name="AlwaysOnTopCheck" Style="{StaticResource MiniToggleStyle}"
                                              Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="开机启动" FontSize="8" Foreground="{StaticResource ScreenTextBrush}"
                                               VerticalAlignment="Center" />
                                    <CheckBox x:Name="StartWithWindowsCheck" Style="{StaticResource MiniToggleStyle}"
                                              Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="标题栏隐藏" FontSize="8" Foreground="{StaticResource ScreenTextBrush}"
                                               VerticalAlignment="Center"
                                               ToolTip="勾选后，窗口失去焦点时隐藏顶部标题栏；页面位置保持不变" />
                                    <CheckBox x:Name="HideTitleBarCheck" Style="{StaticResource MiniToggleStyle}"
                                              Margin="6,0,0,0" VerticalAlignment="Center"
                                              ToolTip="失焦时隐藏顶部标题栏，页面不位移" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                        </StackPanel>
                    </ScrollViewer>
                    <Grid Grid.Row="1" Margin="0,4,0,0" Height="30">
                        <Button x:Name="SaveSettingsButton" Content="保存并应用" Style="{StaticResource MiniPrimaryButtonStyle}"
                                HorizontalAlignment="Left" Click="SaveSettings_Click" />
                        <TextBlock x:Name="SettingsStatusText" Text="" Style="{StaticResource CompactCaptionStyle}"
                                   FontSize="7" Foreground="{StaticResource AccentCyanBrush}"
                                   VerticalAlignment="Center" Margin="80,0,0,0" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Grid>
            </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
