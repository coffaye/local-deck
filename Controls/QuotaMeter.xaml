<UserControl x:Class="LocalDeck.Controls.QuotaMeter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LocalDeck.Controls"
             x:Name="Root"
             Focusable="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                <TextBlock Text="{Binding Label, ElementName=Root}"
                           FontFamily="{DynamicResource UiFont}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ScreenTextBrush}" />
                <TextBlock Text="{Binding Caption, ElementName=Root}"
                           Margin="8,0,0,0"
                           FontFamily="{DynamicResource MonoFont}"
                           FontSize="9"
                           Foreground="{DynamicResource ScreenMutedBrush}" />
            </StackPanel>
            <TextBlock Grid.Column="1"
                       Text="{Binding RemainingText, ElementName=Root}"
                       FontFamily="{DynamicResource MonoFont}"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{Binding Accent, ElementName=Root}" />
        </Grid>

        <local:SegmentedBar Grid.Row="1"
                            Height="8"
                            VerticalAlignment="Center"
                            Value="{Binding Remaining, ElementName=Root}"
                            Fill="{Binding Accent, ElementName=Root}"
                            Track="{DynamicResource ScreenTrackBrush}"
                            SegmentCount="22" />

        <Grid Grid.Row="2" Margin="0,5,0,0">
            <TextBlock Text="{Binding ResetText, ElementName=Root}"
                       FontFamily="{DynamicResource UiFont}"
                       FontSize="10"
                       Foreground="{DynamicResource ScreenMutedBrush}" />
            <TextBlock Text="{Binding Note, ElementName=Root}"
                       HorizontalAlignment="Right"
                       FontFamily="{DynamicResource UiFont}"
                       FontSize="10"
                       Foreground="{DynamicResource ScreenMutedBrush}"
                       TextTrimming="CharacterEllipsis" />
        </Grid>
    </Grid>
</UserControl>
