<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>LocalDeck</AssemblyName>
    <RootNamespace>LocalDeck</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\LocalDeck.ico</ApplicationIcon>
    <Version>1.7.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AssemblyTitle>桌仪 LocalDeck</AssemblyTitle>
    <Product>桌仪 LocalDeck</Product>
    <Description>Local system and AI quota instrument panel</Description>
    <Copyright>LocalDeck</Copyright>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="assets\DSEG7Classic-BoldItalic.ttf" />
    <Resource Include="assets\DSEG7Classic-Regular.ttf" />
    <Resource Include="assets\LocalDeck-logo.png" />
    <Resource Include="assets\LocalDeck.ico" />
    <None Include="assets\DSEG-LICENSE.txt" CopyToOutputDirectory="Never" />
    <None Include="assets\LibreHardwareMonitor-NOTICE.txt" CopyToOutputDirectory="Never" />
  </ItemGroup>

</Project>



